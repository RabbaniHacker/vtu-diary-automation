# VTU Diary Automation .gitignore

# Sensitive user credentials (DO NOT COMMIT!)
credentials.json

# User state and history
state.json

# Screenshots & personal media
screenshots/*.png
screenshots/*.jpg

# Log files
logs/*.log

# Word diary documents (contain personal internship details)
*.docx
*.doc
!sample_diary_template.docx

# Python bytecode & cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/
.env

# Editor settings
.vscode/
.idea/

